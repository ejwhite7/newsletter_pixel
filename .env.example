# Newsletter Tracking Pixel Configuration
# Copy this file to .env for local development

# Required: destination for tracking events. Use a non-production webhook locally.
POSTHOG_WEBHOOK_URL=https://webhooks.us.posthog.com/public/webhooks/YOUR-WEBHOOK-ID

# Required: at least 32 random bytes used to encrypt and authenticate tracking tokens.
# Generate with: openssl rand -base64 32
TRACKING_TOKEN_SECRET=

# Optional during migration only. Signed-only delivery is the secure default.
ALLOW_UNSIGNED_TRACKING=false

# Required when unsigned migration is enabled. Legacy delivery stops after this ISO timestamp.
UNSIGNED_TRACKING_EXPIRES_AT=

# Optional during secret rotation. Remove after all active tokens use the current secret.
TRACKING_TOKEN_SECRET_PREVIOUS=
